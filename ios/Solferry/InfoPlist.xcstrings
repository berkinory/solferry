    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solferry findet deine anderen Geräte in diesem Netzwerk und sendet Dateien direkt an sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solferry finds your other devices on this network and sends files straight to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solferry encuentra tus otros dispositivos en esta red y les envía archivos directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solferry trouve vos autres appareils sur ce réseau et leur envoie des fichiers directement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solferry מוצאת את המכשירים האחרים שלך ברשת הזו ושולחת אליהם קבצים ישירות."
