    "Check that the other device shows this code, then accept there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob das andere Gerät diesen Code anzeigt, und bestätige dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que el otro dispositivo muestra este código y acepta allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que l'autre appareil affiche ce code, puis confirmez sur celui-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica che l'altro dispositivo mostri questo codice, poi accetta da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のデバイスに同じコードが表示されていることを確かめてから、相手のデバイスで承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대 기기에 같은 코드가 표시되는지 확인한 후 상대 기기에서 수락하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer of het andere apparaat deze code toont en accepteer het verzoek daar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź, czy drugie urządzenie pokazuje ten sam kod, i zaakceptuj na nim."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o outro dispositivo mostra este código e aceite por lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что на другом устройстве этот же код, и примите запрос там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer cihazda da bu kodun göründüğünü kontrol et, sonra orada onayla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що на іншому пристрої цей самий код, і прийміть запит там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认对方设备显示的是这个配对码，然后在对方设备上接受。"
          }
        }
      }
