    "Nobody new can find this device. Paired devices can still reach it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Geräte können dieses Gerät nicht finden. Gekoppelte Geräte erreichen es weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún dispositivo nuevo podrá encontrarlo. Los vinculados seguirán pudiendo conectarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun nouvel appareil ne peut le trouver. Les appareils associés peuvent toujours le joindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun nuovo dispositivo può trovarlo. Quelli abbinati possono comunque raggiungerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいデバイスからは見つかりません。ペアリング済みのデバイスからは引き続き接続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 기기는 이 기기를 찾을 수 없어요. 페어링된 기기는 계속 연결할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe apparaten kunnen dit apparaat niet vinden. Gekoppelde apparaten bereiken het nog wel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nowy nie znajdzie tego urządzenia. Sparowane urządzenia nadal mogą się z nim łączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dispositivo novo pode encontrar este. Os pareados ainda podem se conectar a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые устройства его не найдут. Сопряжённые устройства по-прежнему могут подключаться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni cihazlar bu cihazı bulamaz. Eşleştirilmiş cihazlar yine de ulaşabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові пристрої його не знайдуть. Пристрої в парі й надалі можуть підключатися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新设备无法发现本设备，已配对的设备仍可连接。"
          }
        }
      }
    },
