    "It can't send files or ask to pair. You can unblock it later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät kann dir keine Dateien senden und keine Kopplung anfragen. Du kannst es später wieder freigeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podrá enviarte archivos ni pedir la vinculación. Puedes desbloquearlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne pourra plus vous envoyer de fichiers ni demander à s'associer. Vous pourrez le débloquer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrà inviarti file né chiedere di abbinarsi. Puoi sbloccarlo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの送信やペアリングのリクエストができなくなります。ブロックは後で解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 파일을 보내거나 페어링을 요청할 수 없게 돼요. 차단은 나중에 해제할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kan je geen bestanden meer sturen en niet meer vragen om te koppelen. Je kunt het later deblokkeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będzie mogło wysyłać plików ani prosić o sparowanie. Możesz je później odblokować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele não poderá enviar arquivos nem pedir pareamento. Você pode desbloquear depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно не сможет отправлять файлы или запрашивать сопряжение. Разблокировать его можно позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana dosya gönderemez, eşleşme isteği de yollayamaz. Engeli daha sonra kaldırabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він не зможе надсилати файли або запитувати створення пари. Розблокувати його можна пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它将无法向你发送文件或请求配对。你之后可以解除屏蔽。"
          }
        }
      }
    },
    "It goes back to being an unpaired device until you pair again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist danach nicht mehr gekoppelt, bis du es erneut koppelst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará de estar vinculado hasta que lo vuelvas a vincular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne sera plus associé, jusqu'à ce que vous l'associiez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sarà più abbinato finché non lo abbini di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度ペアリングするまで、未ペアリングのデバイスとして扱われます。"
