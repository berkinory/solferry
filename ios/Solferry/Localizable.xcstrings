    "Devices on your network can see this one and ask to send." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte in deinem Netzwerk sehen dieses Gerät und können dir Dateien anbieten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos de tu red pueden verlo y pedir permiso para enviarte archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils de votre réseau peuvent voir celui-ci et lui proposer des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi sulla tua rete possono vederlo e chiedere di inviarti file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じネットワーク上のデバイスからこのデバイスが見え、ファイルの送信をリクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네트워크의 기기가 이 기기를 보고 파일 전송을 요청할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparaten op je netwerk kunnen dit apparaat zien en vragen om iets te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenia w Twojej sieci widzą to urządzenie i mogą proponować mu pliki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos na sua rede podem ver este e pedir para enviar arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства в вашей сети видят это устройство и могут предлагать ему файлы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağındaki cihazlar bu cihazı görebilir ve dosya göndermek için izin isteyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрої у вашій мережі бачать цей пристрій і можуть пропонувати йому файли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一网络中的设备可以看到本设备，并请求向你发送文件。"
          }
        }
      }
    },
